{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "miles-workbench values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infra"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm injects the umbrella chart's global values into every subchart, so a strict root has to accept them."
    },
    "miles-common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object"
        }
      },
      "description": "Helm reserves a values section per dependency; the library chart itself consumes none."
    },
    "infra": {
      "$ref": "#/definitions/InfraValues"
    },
    "objectName": {
      "maxLength": 52,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "type": "string"
    },
    "resources": {
      "$ref": "#/definitions/WorkbenchResources"
    },
    "rbac": {
      "$ref": "#/definitions/RbacSection"
    },
    "serviceAccount": {
      "$ref": "#/definitions/ServiceAccountSection"
    },
    "uninstaller": {
      "$ref": "#/definitions/Uninstaller"
    }
  },
  "definitions": {
    "DevShm": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "hostPath"
          ]
        },
        {
          "required": [
            "emptyDir"
          ]
        }
      ],
      "properties": {
        "mountPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "hostPath": {
          "$ref": "#/definitions/HostPathSource"
        },
        "emptyDir": {
          "$ref": "#/definitions/EmptyDirSource"
        }
      },
      "required": [
        "mountPath"
      ],
      "type": "object"
    },
    "EmptyDirSource": {
      "additionalProperties": false,
      "properties": {
        "medium": {
          "enum": [
            "",
            "Memory"
          ],
          "type": "string"
        },
        "sizeLimit": {
          "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMk]i?|m)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "HostPathSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "type": {
          "enum": [
            "Directory",
            "DirectoryOrCreate"
          ],
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "minLength": 1,
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "pullSecrets": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "type": "object"
    },
    "InfraValues": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/Image"
        },
        "volumes": {
          "items": {
            "$ref": "#/definitions/VolumeEntry"
          },
          "type": "array"
        },
        "paths": {
          "$ref": "#/definitions/Paths"
        },
        "devShm": {
          "$ref": "#/definitions/DevShm"
        },
        "scheduling": {
          "$ref": "#/definitions/Scheduling"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "PYTHONPATH",
                "MILES_SCRIPT_ENV_REPORT",
                "MILES_CELL_INDEX",
                "MILES_POD_INDEX",
                "MILES_BASE_GPU_ID",
                "MILES_K8S_NAMESPACE",
                "MILES_K8S_RELEASE"
              ]
            },
            "pattern": "^[ -<>-~]+$"
          },
          "type": "object"
        }
      },
      "required": [
        "image",
        "volumes"
      ],
      "type": "object"
    },
    "Paths": {
      "additionalProperties": false,
      "properties": {
        "runsRoot": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        }
      },
      "type": "object"
    },
    "PersistentVolumeClaimSource": {
      "additionalProperties": false,
      "properties": {
        "claimName": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "type": "string"
        }
      },
      "required": [
        "claimName"
      ],
      "type": "object"
    },
    "RbacSection": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "leaderWorkerSets": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Scheduling": {
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tolerations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "affinity": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "type": "object"
    },
    "ServiceAccountSection": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Uninstaller": {
      "additionalProperties": false,
      "properties": {
        "serviceAccount": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "VolumeEntry": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "hostPath"
          ]
        },
        {
          "required": [
            "persistentVolumeClaim"
          ]
        },
        {
          "required": [
            "emptyDir"
          ]
        }
      ],
      "properties": {
        "name": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "type": "string"
        },
        "hostPath": {
          "$ref": "#/definitions/HostPathSource"
        },
        "persistentVolumeClaim": {
          "$ref": "#/definitions/PersistentVolumeClaimSource"
        },
        "emptyDir": {
          "$ref": "#/definitions/EmptyDirSource"
        },
        "mounts": {
          "items": {
            "$ref": "#/definitions/VolumeMount"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "name",
        "mounts"
      ],
      "type": "object"
    },
    "VolumeMount": {
      "additionalProperties": false,
      "properties": {
        "mountPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "subPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^([^/].*)?$",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "mountPath"
      ],
      "type": "object"
    },
    "WorkbenchResources": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "object"
        },
        "limits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}
