+# group size from which torch_tpu's grouped weight-gradient kernels are right
+_TPU_GROUP_ROWS = 256
+
+
+class _TpuGroupedMM(torch.autograd.Function):
+    """``torch._grouped_mm`` whose weight gradient is right for small and empty groups on TPU.
+
+    torch_tpu's grouped weight-gradient kernels return wrong values for groups under ~256 rows and leave empty
+    groups unwritten, so the backward starts every group at a 256-row boundary (zero rows between) and zeroes the
+    empty groups.
+    """
+
+    @staticmethod
+    def forward(ctx, input_RI: torch.Tensor, weight_EIO: torch.Tensor, offsets_E: torch.Tensor) -> torch.Tensor:
+        ctx.save_for_backward(input_RI, weight_EIO, offsets_E)
+        return torch._grouped_mm(input_RI, weight_EIO, offs=offsets_E)
+
+    @staticmethod
+    def backward(ctx, grad_RO: torch.Tensor):
+        input_RI, weight_EIO, offsets_E = ctx.saved_tensors
+        grad_RO = grad_RO.contiguous()
+        grad_input_RI = torch._grouped_mm(grad_RO, weight_EIO.transpose(-2, -1), offs=offsets_E)
+
+        num_groups, num_rows = offsets_E.shape[0], input_RI.shape[0]
+        rows_R = torch.arange(num_rows, device=input_RI.device)
+        # rows past offsets_E[-1] (dispatcher padding) form one more group, dropped from the result: indexing past
+        # the last group would be clamped and add them to the last expert
+        ends = torch.cat([offsets_E.long(), offsets_E.new_full((1,), num_rows).long()])
+        sizes = torch.diff(ends, prepend=ends.new_zeros(1))
+        padded = (sizes + _TPU_GROUP_ROWS - 1) // _TPU_GROUP_ROWS * _TPU_GROUP_ROWS
+        capacity = -(-(num_rows + (num_groups + 1) * (_TPU_GROUP_ROWS - 1)) // _TPU_GROUP_ROWS) * _TPU_GROUP_ROWS
+        # a row's group is the number of group ends at or below it (repeat_interleave lowers through a cumsum)
+        group_R = (rows_R[:, None] >= ends[None, :num_groups]).sum(1)
+        dest_R = (integer_cumsum(padded) - padded)[group_R] + rows_R - (ends - sizes)[group_R]
+        input_padded = input_RI.new_zeros(capacity, input_RI.shape[1]).index_copy(0, dest_R, input_RI)
+        grad_padded = grad_RO.new_zeros(capacity, grad_RO.shape[1]).index_copy(0, dest_R, grad_RO)
+        # rows past the padded groups form a last group whose result is dropped too
+        group_sizes = torch.cat([padded, (capacity - padded.sum()).reshape(1)]).to(torch.int32)
+        grad_weight = torch.tpu.ops.ragged_dot_weight_grad(input_padded, grad_padded, group_sizes)[:num_groups]
+        grad_weight = torch.where((sizes[:num_groups] > 0)[:, None, None], grad_weight, 0).to(weight_EIO.dtype)
+        return grad_input_RI, grad_weight, None
+
+
