{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "miles-workbench values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infra"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm injects the umbrella chart's global values into every subchart, so a strict root has to accept them."
    },
    "miles-common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "object"
        }
      },
      "description": "Helm reserves a values section per dependency; the library chart itself consumes none."
    },
    "infra": {
      "$ref": "#/definitions/InfraValues"
    },
    "objectName": {
      "maxLength": 52,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "type": "string"
    },
    "resources": {
      "$ref": "#/definitions/WorkbenchResources"
    },
    "rbac": {
      "$ref": "#/definitions/RbacSection"
    },
    "serviceAccount": {
      "$ref": "#/definitions/ServiceAccountSection"
    }
  },
  "definitions": {
    "Image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "minLength": 1,
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "pullSecrets": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "type": "object"
    },
    "InfraValues": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/Image"
        },
        "sharedStorage": {
          "$ref": "#/definitions/SharedStorage"
        },
        "scheduling": {
          "$ref": "#/definitions/Scheduling"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[ -<>-~]+$"
          },
          "type": "object"
        }
      },
      "required": [
        "image",
        "sharedStorage"
      ],
      "type": "object"
    },
    "RbacSection": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "leaderWorkerSets": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Scheduling": {
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tolerations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "affinity": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "type": "object"
    },
    "ServiceAccountSection": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SharedStorage": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "hostPath"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "hostPath": {
                "minLength": 1
              }
            },
            "required": [
              "hostPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pvc"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "pvcClaimName": {
                "minLength": 1
              }
            },
            "required": [
              "pvcClaimName"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "hostPath",
            "pvc",
            "none"
          ],
          "type": "string"
        },
        "mountPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "hostPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^(/.*)?$",
          "type": "string"
        },
        "pvcClaimName": {
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mountPath"
      ],
      "type": "object"
    },
    "WorkbenchResources": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "object"
        },
        "limits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}
