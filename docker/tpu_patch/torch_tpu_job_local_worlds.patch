diff --git a/tests/distributed/job_local_world_test.py b/tests/distributed/job_local_world_test.py
new file mode 100644
index 000000000..103b4c5b9
--- /dev/null
+++ b/tests/distributed/job_local_world_test.py
@@ -0,0 +1,131 @@
+# Copyright 2026 Google LLC
