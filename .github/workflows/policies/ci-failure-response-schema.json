{
  "$id": "ci-failure-response-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "analyses": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "tags",
          "test_name",
          "reason",
          "category",
          "confidence",
          "evidence_refs",
          "related_pull_request"
        ],
        "properties": {
          "job_id": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "test_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "category": {
            "type": "string",
            "enum": [
              "test_failure",
              "build",
              "infra",
              "timeout",
              "unknown"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "related_pull_request": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
