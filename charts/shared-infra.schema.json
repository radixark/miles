{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Miles shared infra values",
  "description": "Cluster-shaped values that every Miles chart accepts under the same paths, so one user-maintained values.yaml drives miles-workbench and miles-run alike. Helm does not resolve cross-file $ref, so each chart inlines these definitions verbatim into its own values.schema.json; tools/kubernetes/generate_chart_schema.py writes them from the same Python types.",
  "type": "object",
  "properties": {
    "infra": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/Image"
        },
        "sharedStorage": {
          "$ref": "#/definitions/SharedStorage"
        },
        "scheduling": {
          "$ref": "#/definitions/Scheduling"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[ -<>-~]+$"
          },
          "type": "object"
        }
      },
      "required": [
        "image",
        "sharedStorage"
      ],
      "type": "object"
    }
  },
  "definitions": {
    "Image": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "minLength": 1,
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "pullSecrets": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "type": "object"
    },
    "Scheduling": {
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tolerations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "affinity": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "type": "object"
    },
    "SharedStorage": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "hostPath"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "hostPath": {
                "minLength": 1
              }
            },
            "required": [
              "hostPath"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pvc"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "pvcClaimName": {
                "minLength": 1
              }
            },
            "required": [
              "pvcClaimName"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "hostPath",
            "pvc",
            "none"
          ],
          "type": "string"
        },
        "mountPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^/",
          "type": "string"
        },
        "hostPath": {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^(/.*)?$",
          "type": "string"
        },
        "pvcClaimName": {
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mountPath"
      ],
      "type": "object"
    }
  }
}
