# doc-dev: docs/developer/ci/02-docker-build.md
# miles on TPU v7x through torch_tpu. Build via docker/build.py:
#       python docker/build.py --variant tpu --image-tag dev --push   # radixark/miles:dev-tpu (amd64)
#
# One Python environment for the sglang-torchtpu engine and the torchtitan trainer, on the CUDA image's torch.
# sglang-torchtpu releases on torch 2.11, but the torchtitan backend needs torch >= 2.14; torch_tpu carries
# builds for torch 2.11-2.15.

ARG SGLANG_TPU_IMAGE_TAG=v0.1.0-tpu
FROM lmsysorg/sglang:${SGLANG_TPU_IMAGE_TAG}

# ======================================== Arguments =============================================

ARG SGLANG_TPU_REPO=sgl-project/sglang-torchtpu
# sglang-torchtpu main (2026-11-24, with sgl-project/sglang-torchtpu#2299); swap the commit for a release image tag
# once one ships.
ARG SGLANG_TPU_COMMIT=b5391b80c58b75781ce36e3ca5e95c4e92367740
ARG TORCH_VERSION=2.14.1
ARG TORCHVISION_VERSION=0.29.1
# the triton torch 2.14 pairs with; torchtitan imports triton unconditionally
ARG TRITON_VERSION=3.8.0
ARG TORCHTITAN_REPO=pytorch/torchtitan
# TORCHTITAN_COMMIT and WHEELS_TAG equal docker/Dockerfile's (tests/fast/test_training_images.py checks it); bumping
# TORCHTITAN_COMMIT means rebasing docker/tpu_patch/torchtitan_torch_tpu.patch, which applies with --fuzz=0
ARG TORCHTITAN_COMMIT=45e33cd413b64cb37a7840cfd3c9765d3c639ae1
ARG MILES_COMMIT=main
ARG WHEELS_REPO=radixark/miles-wheels
ARG WHEELS_TAG=cu130-torch214-x86_64
# torch_tpu main + docker/tpu_patch/torch_tpu_job_local_worlds.patch (--update-weight-transfer-mode ici)
# + docker/tpu_patch/torch_tpu_chunk_cat.patch (FSDP2's reduce-scatter copy-in)
ARG TORCH_TPU_WHEELS_TAG=torch-tpu-e8468781a-pr6110-pr6728-v2
ARG TORCH_TPU_WHEEL=torch_tpu-0.2.1.dev2026111702-cp312-cp312-manylinux_2_31_x86_64.whl
ARG TARGETARCH

# ====================================== Install sglang-torchtpu ============================================

# The base image's /sgl-workspace/sglang is a source tree without git history, installed editable. The reinstall
# takes the commit's python/pyproject_tpu.toml dependencies except its TPU stack (torch, torch_tpu, libtpu,
# tpu-sync-torch), which stays the release's until the torch step below replaces torch and torch_tpu.
RUN SGLANG_VERSION=$(python3 -c 'import importlib.metadata as m; print(m.version("sglang"))') && \
    SGLANG_TPU_VERSION=$(python3 -c 'import importlib.metadata as m; print(m.version("sglang-tpu"))') && \
    rm -rf /sgl-workspace/sglang && git init -q /sgl-workspace/sglang && cd /sgl-workspace/sglang && \
    git fetch -q --depth 1 https://github.com/${SGLANG_TPU_REPO}.git ${SGLANG_TPU_COMMIT} && git checkout -q FETCH_HEAD && \
    cp python/pyproject_tpu.toml python/pyproject.toml && \
    python3 -c 'import re, tomllib; \
tpu_stack = {"torch", "torchvision", "torchaudio", "torch-tpu", "libtpu", "tpu-sync-torch"}; \
deps = tomllib.load(open("python/pyproject.toml", "rb"))["project"]["dependencies"]; \
print("\n".join(d for d in deps if re.match(r"[\w.-]+", d)[0].lower().replace("_", "-") not in tpu_stack))' \
        > /tmp/sglang-tpu-requirements.txt && \
    pip install -r /tmp/sglang-tpu-requirements.txt && rm /tmp/sglang-tpu-requirements.txt && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SGLANG=${SGLANG_VERSION} pip install --no-deps -e python && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SGLANG_TPU=${SGLANG_TPU_VERSION} pip install --no-deps -e .

# ====================================== Torch ============================================

# torch_tpu with job-local worlds (google-pytorch/torch_tpu#6110), so a trainer and an engine can share one slice
# (ICI weight sync), and a _chunk_cat.out kernel (google-pytorch/torch_tpu#6728), without which the trainer's first
# backward spends ~100 s compiling FSDP2's gradient copy-in per vocabulary-sized unit; same libtpu as the release.
# Rebuild: bazel build --config=wheel_release --config=no_rbe //ci/wheel:torch_tpu_wheel on google-pytorch/torch_tpu
# e8468781a (main, 2026-11-03) with both patches applied in that order.
RUN curl -fsSL -o "/tmp/${TORCH_TPU_WHEEL}" \
    "https://github.com/${WHEELS_REPO}/releases/download/${TORCH_TPU_WHEELS_TAG}/${TORCH_TPU_WHEEL}" && \
    pip install --no-deps --force-reinstall "/tmp/${TORCH_TPU_WHEEL}" && rm "/tmp/${TORCH_TPU_WHEEL}"

# torch_tpu and libtpu stay as installed above; the constraints keep every later install on this torch and them
RUN TORCH_TPU_PIN=$(python3 -c 'import importlib.metadata as m; print(m.version("torch_tpu"))') && \
    LIBTPU_PIN=$(python3 -c 'import importlib.metadata as m; print(m.version("libtpu"))') && \
    printf "torch==${TORCH_VERSION}\ntorchvision==${TORCHVISION_VERSION}\ntorch_tpu==${TORCH_TPU_PIN}\nlibtpu==${LIBTPU_PIN}\ntriton==${TRITON_VERSION}\n" \
        > /opt/torch-constraints.txt && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu -c /opt/torch-constraints.txt \
        "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}"

# ====================================== Install torchtitan ============================================

# with miles' torch_tpu patch and its own dependencies (the constraints keep torch)
COPY docker/tpu_patch/torchtitan_torch_tpu.patch /tmp/torchtitan_torch_tpu.patch
RUN git clone https://github.com/${TORCHTITAN_REPO}.git /root/torchtitan && \
    cd /root/torchtitan && git checkout -f ${TORCHTITAN_COMMIT} && \
    patch --fuzz=0 -p1 < /tmp/torchtitan_torch_tpu.patch && rm /tmp/torchtitan_torch_tpu.patch && \
    pip install -c /opt/torch-constraints.txt -e .

# ====================================== Install main package ============================================

# miles, without the CUDA-only requirements; its transformers and ray pins replace the release's
# the dashboard plugin is installed only when MILES_COMMIT already has it
RUN git clone https://github.com/radixark/miles.git /root/miles && \
    cd /root/miles && git checkout ${MILES_COMMIT} && \
    pip install --no-deps -e . && \
    if [ -d packages/miles-dashboard ]; then pip install --no-deps -e packages/miles-dashboard; fi && \
    grep -vE '^\s*(#|$)|nvidia-resiliency-ext|ring_flash_attn|torchft-nightly' requirements.txt > /tmp/requirements-tpu.txt && \
    pip install -c /opt/torch-constraints.txt --extra-index-url https://download.pytorch.org/whl/cpu -r /tmp/requirements-tpu.txt && \
    rm /tmp/requirements-tpu.txt

# miles' router build: the PyPI sglang-router drops return_routed_experts, which rollout routing replay needs.
# The release replaces its assets in place, so the wheel is looked up; github_token (docker/build.py's
# BUILD_GITHUB_TOKEN) authenticates the lookup, and builds without it go anonymous.
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then set -- -H "Authorization: Bearer $(cat /run/secrets/github_token)"; \
    else set --; fi && \
    url=$(curl -fsSL "$@" "https://api.github.com/repos/${WHEELS_REPO}/releases/tags/${WHEELS_TAG}" \
    | python3 -c "import json, sys; print(next(a['browser_download_url'] for a in json.load(sys.stdin)['assets'] \
if a['name'].startswith('sglang_router-') and a['name'].endswith('.whl')))") && \
    curl -fsSL -o "/tmp/$(basename "$url")" "$url" && \
    pip install --no-deps --force-reinstall /tmp/sglang_router-*.whl && rm /tmp/sglang_router-*.whl

COPY docker/install-kube-tools.sh /tmp/install-kube-tools.sh
RUN bash /tmp/install-kube-tools.sh "${TARGETARCH}" && rm -f /tmp/install-kube-tools.sh

# imports only, before MILES_ACCELERATOR=tpu: the build host has no TPU. miles' torchtitan package goes
# first: it backports the torch 2.15 APIs torchtitan 0.4.0 imports, and training_engine is what miles runs.
RUN python3 -c 'import sglang.srt.entrypoints.http_server, sglang_tpu, torch, ray, \
miles.backends.torchtitan_utils.actor, torchtitan.training_engine; \
assert torch.__version__.startswith("'"${TORCH_VERSION}"'"), torch.__version__'

ENV MILES_ACCELERATOR=tpu
WORKDIR /root/miles
CMD ["/bin/bash"]
