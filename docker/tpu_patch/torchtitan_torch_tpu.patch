+# Group size from which torch_tpu's grouped weight-gradient kernels are right.
+_TPU_GROUP_ROWS = 256
+
+
+class _TpuGroupedMM(torch.autograd.Function):
+    """``torch._grouped_mm`` with a weight gradient that is right for small groups on TPU.
+
+    torch_tpu's grouped weight-gradient kernels (``_grouped_mm`` 2D x 2D and ``ragged_dot_weight_grad``)
+    return wrong values for groups of fewer than ~256 rows and leave empty groups unwritten. The
+    backward places every group at a 256-row boundary, padded with zero rows, which changes no
+    gradient, and zeroes the empty groups.
+    """
+
+    @staticmethod
+    def forward(ctx, a: torch.Tensor, b_t: torch.Tensor, offs: torch.Tensor) -> torch.Tensor:
+        ctx.save_for_backward(a, b_t, offs)
+        return torch._grouped_mm(a, b_t, offs=offs)
+
+    @staticmethod
+    def backward(ctx, grad_out: torch.Tensor):
+        a, b_t, offs = ctx.saved_tensors
+        grad_out = grad_out.contiguous()
+        grad_a = torch._grouped_mm(grad_out, b_t.transpose(-2, -1), offs=offs)
+
+        num_groups, num_rows = offs.shape[0], a.shape[0]
+        rows = torch.arange(num_rows, device=a.device)
+        # Rows past offs[-1] (a dispatcher's padding) belong to no expert: they form one more group, laid out
+        # like the others and dropped from the result. Indexing past the last group instead would be clamped,
+        # not raised, and add them to the last expert's gradient.
+        ends = torch.cat([offs.long(), offs.new_full((1,), num_rows).long()])
+        sizes = torch.diff(ends, prepend=ends.new_zeros(1))
+        padded = (sizes + _TPU_GROUP_ROWS - 1) // _TPU_GROUP_ROWS * _TPU_GROUP_ROWS
+        capacity = -(-(num_rows + (num_groups + 1) * (_TPU_GROUP_ROWS - 1)) // _TPU_GROUP_ROWS) * _TPU_GROUP_ROWS
+        # Row r is in group g iff ends[g-1] <= r < ends[g]: g is the number of group ends at or below r. A
+        # repeat_interleave would lower through an integer cumsum, which torch_tpu cannot lower under
+        # the trainer's --xla_tpu_use_associative_scan_emitter=false (see integer_cumsum).
+        group = (rows[:, None] >= ends[None, :num_groups]).sum(1)
+        dest = (integer_cumsum(padded) - padded)[group] + rows - (ends - sizes)[group]
+        a_padded = a.new_zeros(capacity, a.shape[1]).index_copy(0, dest, a)
+        grad_padded = grad_out.new_zeros(capacity, grad_out.shape[1]).index_copy(0, dest, grad_out)
+        # Rows past the padded groups form a last group whose result is dropped too.
+        group_sizes = torch.cat([padded, (capacity - padded.sum()).reshape(1)]).to(torch.int32)
+        grad_b = torch.tpu.ops.ragged_dot_weight_grad(a_padded, grad_padded, group_sizes)[:num_groups]
+        grad_b = torch.where((sizes[:num_groups] > 0)[:, None, None], grad_b, 0).to(b_t.dtype)
+        return grad_a, grad_b, None
+
+
