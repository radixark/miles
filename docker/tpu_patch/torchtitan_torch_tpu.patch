+class _TpuDeviceModule(ModuleType):
+    """``torch.tpu`` with its device APIs routed to ``torch.accelerator``.
+
+    torch_tpu refuses calls to those ``torch.tpu`` APIs from outside torch and torch_tpu, and calls them itself,
+    so this is a view rather than a patch on ``torch.tpu``.
+    """
+
+    def __init__(self, tpu_module: ModuleType) -> None:
+        super().__init__(tpu_module.__name__, tpu_module.__doc__)
+        self._tpu_module = tpu_module
+
+    def __getattr__(self, name: str):
+        return getattr(self._tpu_module, name)
+
+    @staticmethod
+    def is_available() -> bool:
+        return torch.accelerator.is_available()
+
+    @staticmethod
+    def device_count() -> int:
+        return torch.accelerator.device_count()
+
+    @staticmethod
+    def current_device() -> int:
+        return torch.accelerator.current_device_index()
+
+    @staticmethod
+    def set_device(device: int | str | torch.device) -> None:
+        torch.accelerator.set_device_index(device)
+
+    @staticmethod
+    def synchronize(device: int | str | torch.device | None = None) -> None:
+        torch.accelerator.synchronize(device)
+
+    @staticmethod
+    def current_stream(device: int | str | torch.device | None = None):
+        return torch.accelerator.current_stream(device)
+
+    @staticmethod
+    def set_stream(stream) -> None:
+        torch.accelerator.set_stream(stream)
+
+    # torch_tpu implements these through torch.accelerator only
+    @staticmethod
+    def reset_peak_memory_stats(device: int | str | torch.device | None = None) -> None:
+        torch.accelerator.reset_peak_memory_stats(device)
+
+    @staticmethod
+    def empty_cache() -> None:
+        torch.accelerator.empty_cache()
+
+    @staticmethod
+    def memory_stats(device: int | str | torch.device | None = None) -> dict:
+        return torch.accelerator.memory_stats(device)
+
+
+def integer_cumsum(x: torch.Tensor, dim: int = 0, *, dtype: torch.dtype | None = None) -> torch.Tensor:
+    """``torch.cumsum`` for integer tensors, in float32 on TPU (exact below 2**24).
+
+    With ``--xla_tpu_use_associative_scan_emitter=false``, which the TPU trainer sets because the emitter
+    miscompiles scans not a multiple of 1024 long, torch_tpu lowers no integer cumsum.
+    """
+    if x.device.type != "tpu" or x.is_floating_point():
+        return torch.cumsum(x, dim, dtype=dtype)
+    return torch.cumsum(x, dim, dtype=torch.float32).to(dtype or x.dtype)
+
+
 def get_device_info() -> tuple[str, ModuleType]:
     device_type = _get_available_device_type() or "cuda"
     device_module = _get_device_module(device_type)  # default device_module:torch.cuda
+    if device_type == "tpu":
+        device_module = _TpuDeviceModule(device_module)
     return device_type, device_module
 
 
